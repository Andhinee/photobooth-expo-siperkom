# Port server
PORT=3000

# ID Folder Utama Google Drive ("Photobooth Expo TA SIPERKOM")
GOOGLE_DRIVE_FOLDER_ID=MASUKKAN_FOLDER_ID_GOOGLE_DRIVE

# === OPSI PALING MUDAH (Gratis, Tanpa Google Cloud Console): Google Apps Script ===
# Deploy google-apps-script.gs di script.google.com lalu tempel URL Web App-nya di sini
GOOGLE_APPS_SCRIPT_URL=

# === OPSI 2 (Untuk Gmail Pribadi via Google Cloud): OAuth2 ===
# Buat "OAuth client ID" (Web application) di Google Cloud Console
# Redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_TOKEN_FILE=./oauth-tokens.json

# === OPSI 2 (Alternatif untuk Google Workspace): Service Account ===
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Opsional: Base URL publik jika website di-host di domain HTTPS
PUBLIC_BASE_URL=

# Opsional: Konfigurasi HTTPS lokal
SSL_KEY_PATH=
SSL_CERT_PATH=
